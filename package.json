{
  "name": "@jeswr/css-entra-external-id",
  "version": "0.1.0",
  "description": "Microsoft Entra External ID login for the Community Solid Server.",
  "keywords": [
    "community-solid-server",
    "entra-external-id",
    "identity-provider",
    "solid",
    "solid-oidc"
  ],
  "license": "MIT",
  "author": "Jesse Wright <https://github.com/jeswr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/css-entra-external-id.git"
  },
  "bugs": {
    "url": "https://github.com/jeswr/css-entra-external-id/issues"
  },
  "homepage": "https://github.com/jeswr/css-entra-external-id#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "lsd:module": "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-entra-external-id",
  "lsd:components": "dist/components/components.jsonld",
  "lsd:contexts": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-entra-external-id/^0.0.0/components/context.jsonld": "dist/components/context.jsonld"
  },
  "lsd:importPaths": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-entra-external-id/^0.0.0/components/": "dist/components/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-entra-external-id/^0.0.0/config/": "config/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-entra-external-id/^0.0.0/dist/": "dist/"
  },
  "files": [
    "config",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:components",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:components": "componentsjs-generator -s src -c dist/components -r entra -i .componentsignore",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --coverage --runInBand",
    "verify": "npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@azure/msal-node": "^5.6.0",
    "global-logger-factory": "^1.0.0",
    "yup": "^1.3.2"
  },
  "peerDependencies": {
    "@solid/community-server": "^8.0.0-alpha.3"
  },
  "devDependencies": {
    "@solid/community-server": "^8.0.0-alpha.3",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.13",
    "componentsjs-generator": "^4.3.0",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "opinionated-eslint-config": "0.2.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
